{
  "manifest_version": 3,
  "name": "ScamShield AI – Scam & Phishing Scanner",
  "version": "1.0.0",
  "description": "AI-powered scam detection platform protecting users from phishing, fraudulent links, and social engineering scams.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://madonna-mouth-mandate-cole.trycloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open ScamShield AI Side Panel",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
